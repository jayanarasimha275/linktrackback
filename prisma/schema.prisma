generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(PUBLISHER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  links     Link[]

  @@map("users")
}

model Link {
  id             Int      @id @default(autoincrement())
  title          String
  shortCode      String   @unique
  destinationUrl String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  clicks         Int      @default(0)
  conversions    Int      @default(0)
  desktopClicks  Int      @default(0)
  mobileClicks   Int      @default(0)
  tabletClicks   Int      @default(0)
  topCountry     String?  @default("No data")
  visitors       Int      @default(0)
  uniqueClicks   Int      @default(0)
  userId         Int
  clicksData     Click[]
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pixel          Pixel?

  @@index([userId])
  @@map("links")
}

model Click {
  id              Int      @id @default(autoincrement())
  linkId          Int
  ipAddress       String?
  visitorId       String?
  cookieId        String?
  browser         String?
  operatingSystem String?
  deviceType      String?
  country         String?
  city            String?
  referrer        String?
  userAgent       String?
  isUnique        Boolean  @default(false)
  clickedAt       DateTime @default(now())
  browserVersion  String?
  clickId         String?  @unique @default(cuid())
  converted       Boolean  @default(false)
  link            Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, visitorId, ipAddress, browser, browserVersion, operatingSystem, deviceType])
}

model Pixel {
  id         Int      @id @default(autoincrement())
  linkId     Int      @unique
  pixelName  String
  pixelCode  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  pixelToken String   @unique @default(cuid())

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@map("pixels")
}

enum Role {
  ADMIN
  PUBLISHER
}
